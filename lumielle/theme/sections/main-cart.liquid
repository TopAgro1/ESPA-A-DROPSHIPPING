<section class="section scheme-white">
  <div class="container container--narrow">
    <h1 class="h2 page-title">{{ 'cart.title' | t }}</h1>
    <div class="cart-page" data-cart-page>
      {% render 'shipping-bar' %}
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty">
          <p>{{ 'cart.empty' | t }}</p>
          <a class="btn btn--brand" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
        </div>
      {%- else -%}
        {% render 'cart-items' %}
        <form action="{{ routes.cart_url }}" method="post" class="cart-page__footer">
          <p class="drawer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_without_trailing_zeros }}</strong></p>
          <button type="submit" name="checkout" class="btn btn--cta btn--lg btn--block">{{ 'cart.checkout' | t }}</button>
          {%- if settings.cart_trust_text != blank -%}<p class="drawer__trust">{{ settings.cart_trust_text }}</p>{%- endif -%}
        </form>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Carrito",
  "tag": "div",
  "class": "section-main-cart",
  "settings": []
}
{% endschema %}
