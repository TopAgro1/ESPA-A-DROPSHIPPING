<section class="section scheme-white">
  <div class="container">
    <header class="section-heading section-heading--left">
      <h1 class="h2">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
    </header>
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="grid grid--products">
        {%- for item in collection.products -%}
          {% render 'product-card', card_product: item %}
        {%- else -%}
          <p>{{ 'collections.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección",
  "tag": "div",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "min": 4, "max": 24, "step": 4, "label": "Productos por página", "default": 12 }
  ]
}
{% endschema %}
