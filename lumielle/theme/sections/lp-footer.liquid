<footer class="footer scheme-ink">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="logo footer__logo" href="{{ routes.root_url }}">{% render 'logo' %}</a>
        {%- if section.settings.text != blank -%}<p class="footer__text">{{ section.settings.text }}</p>{%- endif -%}
        <ul class="footer__social" role="list">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram', size: 22 %}</a></li>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook', size: 22 %}</a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok', size: 22 %}</a></li>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube', size: 22 %}</a></li>{%- endif -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <nav class="footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- if block.settings.menu.links.size > 0 -%}
                <ul class="footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </nav>
          {%- when 'policies' -%}
            <nav class="footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <ul class="footer__links" role="list">
                {%- for policy in shop.policies -%}
                  {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endif -%}
                {%- endfor -%}
              </ul>
            </nav>
          {%- when 'contact' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <ul class="footer__links footer__contact" role="list">
                {%- if settings.whatsapp_number != blank -%}
                  {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
                  <li><a href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp', size: 18 %} WhatsApp</a></li>
                {%- endif -%}
                {%- if settings.contact_email != blank -%}
                  <li><a href="mailto:{{ settings.contact_email }}">{% render 'icon', name: 'mail', size: 18 %} {{ settings.contact_email }}</a></li>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}<li>{% render 'icon', name: 'clock', size: 18 %} {{ block.settings.hours }}</li>{%- endif -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      {%- if section.settings.legal != blank -%}<div class="footer__legal rte">{{ section.settings.legal }}</div>{%- endif -%}
      <div class="footer__meta">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
        {%- if settings.payment_mode == 'cod' -%}
          <p class="footer__cod">{% render 'icon', name: 'cash', size: 18 %} {{ section.settings.cod_text }}</p>
        {%- else -%}
          <ul class="payment__icons" role="list">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment__icon' }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "tag": "div",
  "class": "section-footer",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Texto de marca", "default": "Skincare que funciona y llega a tu puerta. Envío gratis a toda Colombia y pago contra entrega." },
    {
      "type": "richtext",
      "id": "legal",
      "label": "Datos legales",
      "info": "Razón social o nombre del titular, NIT o cédula, dirección y canal de PQR (Estatuto del Consumidor, Ley 1480 de 2011).",
      "default": "<p>Ejerce tu derecho de retracto dentro de los 5 días hábiles siguientes a la entrega. Atención de PQR por WhatsApp y email.</p>"
    },
    { "type": "text", "id": "cod_text", "label": "Texto de pago contra entrega", "default": "Pagas en efectivo al recibir" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menú",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Tienda" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    },
    {
      "type": "policies",
      "name": "Políticas",
      "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Título", "default": "Legal" }]
    },
    {
      "type": "contact",
      "name": "Contacto",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Atención" },
        { "type": "text", "id": "hours", "label": "Horario", "default": "Lunes a sábado, 8:00 a. m. – 6:00 p. m." }
      ]
    }
  ],
  "presets": [{ "name": "Pie de página" }],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
