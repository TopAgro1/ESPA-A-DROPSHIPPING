<section class="section scheme-{{ section.settings.scheme }}" id="faq" data-reveal>
  <div class="container container--narrow">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <div class="faq">
      {%- for block in section.blocks -%}
        <details class="accordion accordion--faq" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span>{{ block.settings.question }}</span>
            {% render 'icon', name: 'plus', size: 20, class: 'accordion__chevron' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if settings.whatsapp_number != blank and section.settings.wa_label != blank -%}
      {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
      <p class="faq__more">
        {{ section.settings.more_text }}
        <a class="link" href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">{{ section.settings.wa_label }}</a>
      </p>
    {%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Preguntas frecuentes",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "white", "label": "Blanco" },
        { "value": "alt", "label": "Alterno" },
        { "value": "tint", "label": "Tinte de marca" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Preguntas frecuentes" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Resolvemos tus dudas" },
    { "type": "inline_richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "more_text", "label": "Texto final", "default": "¿Tienes otra pregunta?" },
    { "type": "text", "id": "wa_label", "label": "Enlace a WhatsApp", "default": "Escríbenos por WhatsApp" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cómo funciona el pago contra entrega?" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Haces tu pedido sin pagar nada en línea. Te confirmamos por WhatsApp y pagas en efectivo cuando el producto llega a tu casa.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Preguntas frecuentes",
      "blocks": [{ "type": "question" }]
    }
  ]
}
{% endschema %}
