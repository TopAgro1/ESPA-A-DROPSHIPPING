<article class="section scheme-white">
  <div class="container container--narrow">
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="h2 page-title">{{ article.title | escape }}</h1>
    {%- if article.image -%}
      <div class="article__image">{% render 'responsive-image', image: article.image, sizes: '(min-width: 990px) 800px, 100vw', eager: true %}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{
  "name": "Artículo",
  "tag": "div",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
