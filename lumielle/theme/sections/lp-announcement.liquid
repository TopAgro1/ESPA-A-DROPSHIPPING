{%- if section.blocks.size > 0 -%}
<div class="announcement scheme-{{ section.settings.scheme }}" data-announcement data-interval="{{ section.settings.interval }}">
  <div class="container announcement__inner">
    {%- for block in section.blocks -%}
      <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon, size: 16 %}{%- endif -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          <span>{{ block.settings.text }}</span>
        {%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "tag": "section",
  "class": "section-announcement",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colores",
      "options": [
        { "value": "brand", "label": "Marca" },
        { "value": "ink", "label": "Oscuro" },
        { "value": "tint", "label": "Tinte suave" }
      ],
      "default": "brand"
    },
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Segundos por mensaje",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Envío GRATIS a toda Colombia · Paga al recibir" },
        { "type": "url", "id": "link", "label": "Enlace" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "truck", "label": "Camión" },
            { "value": "cash", "label": "Efectivo" },
            { "value": "shield", "label": "Escudo" },
            { "value": "gift", "label": "Regalo" },
            { "value": "sparkle", "label": "Destello" },
            { "value": "clock", "label": "Reloj" }
          ],
          "default": "truck"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [
        { "type": "message", "settings": { "text": "Envío GRATIS a toda Colombia · Paga al recibir", "icon": "truck" } },
        { "type": "message", "settings": { "text": "Garantía de satisfacción de 30 días", "icon": "shield" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
