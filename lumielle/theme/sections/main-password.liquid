<section class="section scheme-alt password">
  <div class="container container--narrow center">
    <div class="logo password__logo">{% render 'logo' %}</div>
    <h1 class="h2">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'password__form' -%}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="Password">{{ 'password.label' | t }}</label>
      <input class="input" type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
      <button type="submit" class="btn btn--brand">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contraseña",
  "tag": "div",
  "class": "section-password",
  "settings": []
}
{% endschema %}
