{%- comment -%} Hero de la página de inicio. Sin animación de entrada para no retrasar el LCP. {%- endcomment -%}
{%- if section.index == 1 -%}{%- assign heading_tag = 'h1' -%}{%- else -%}{%- assign heading_tag = 'h2' -%}{%- endif -%}
<section class="hero scheme-{{ section.settings.scheme }}">
  <div class="container hero__inner">
    <div class="hero__body">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <{{ heading_tag }} class="hero__title h1">{{ section.settings.heading }}</{{ heading_tag }}>
      {%- if section.settings.text != blank -%}<p class="hero__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="hero__actions">
        <a class="btn btn--cta btn--lg btn--pulse" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 20, class: 'btn__arrow' %}
        </a>
      </div>
      <ul class="hero__trust" role="list">
        {%- for i in (1..3) -%}
          {%- capture key %}trust_{{ i }}{% endcapture -%}
          {%- if section.settings[key] != blank -%}<li>{% render 'icon', name: 'check-circle', size: 18 %} {{ section.settings[key] }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 990px) 50vw, 100vw', eager: true, preload: true, class: 'hero__img' %}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portada (hero)",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "white", "label": "Blanco" },
        { "value": "alt", "label": "Alterno" },
        { "value": "tint", "label": "Tinte de marca" }
      ],
      "default": "alt"
    },
    { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Repite la imagen o el fotograma del anuncio (message match)." },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Retinol + Colágeno + Ácido hialurónico" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Tu rutina antiedad completa, en una sola crema" },
    { "type": "inline_richtext", "id": "text", "label": "Texto", "default": "Hidratación profunda, piel más suave y un aspecto más firme en rostro y cuello. Pide hoy y paga al recibir." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver la crema" },
    { "type": "url", "id": "link", "label": "Enlace del botón" },
    { "type": "text", "id": "trust_1", "label": "Garantía 1", "default": "Envío gratis" },
    { "type": "text", "id": "trust_2", "label": "Garantía 2", "default": "Paga al recibir" },
    { "type": "text", "id": "trust_3", "label": "Garantía 3", "default": "30 días de garantía" }
  ],
  "presets": [{ "name": "Portada (hero)" }]
}
{% endschema %}
