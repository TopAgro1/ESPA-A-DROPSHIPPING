{%- comment -%}
  Ficha de producto (buy box) + galería. También sirve como "producto destacado" en la página de inicio.
  Packs sin apps: opción de variante "Cantidad" (1 unidad / 2 unidades / 3 unidades) con precio propio.
{%- endcomment -%}
{%- liquid
  if section.settings.product != blank
    assign product = section.settings.product
  endif
  if product == blank
    assign product = collections.all.products.first
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign pack_name = section.settings.pack_option_name | downcase | strip
  assign pack_index = -1
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    if option_name == pack_name and pack_name != blank
      assign pack_index = forloop.index0
    endif
  endfor

  comment
    Preselecciona el pack "Más popular" si el visitante no eligió otra variante.
  endcomment
  if pack_index >= 0 and product.selected_variant == blank and section.settings.preselect_popular and section.settings.popular_position > 0
    assign popular_pos = section.settings.popular_position | minus: 1
    assign popular_value = product.options_with_values[pack_index].values[popular_pos]
    for v in product.variants
      if v.options[pack_index] == popular_value and v.available
        assign same_rest = true
        for o in v.options
          if forloop.index0 != pack_index and o != current_variant.options[forloop.index0]
            assign same_rest = false
          endif
        endfor
        if same_rest
          assign current_variant = v
          break
        endif
      endif
    endfor
  endif

  comment
    Precio de referencia por unidad = variante con "1" en la opción de pack.
  endcomment
  assign unit_price = product.variants.first.price
  if pack_index >= 0
    for v in product.variants
      assign q = v.options[pack_index] | split: ' ' | first | plus: 0
      if q == 1
        assign unit_price = v.price
        break
      endif
    endfor
    assign current_qty = current_variant.options[pack_index] | split: ' ' | first | plus: 0
  endif
  if current_qty == blank or current_qty < 1
    assign current_qty = 1
  endif
  assign ref_price = unit_price | times: current_qty
  assign per_unit = current_variant.price | divided_by: current_qty

  assign is_cod = false
  if settings.payment_mode == 'cod'
    assign is_cod = true
  endif

  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value
-%}

<section
  class="product section scheme-{{ section.settings.scheme }}"
  data-product-section
  data-section-id="{{ section.id }}"
  data-form-id="{{ product_form_id }}"
  data-pack-index="{{ pack_index }}"
  data-unit-price="{{ unit_price }}"
  {% if template.name == 'product' %}data-update-url{% endif %}
>
  <div class="container product__grid">
    <div class="product__media">
      {%- assign media_count = product.media.size -%}
      <div class="gallery gallery--{{ section.settings.media_ratio }}" data-gallery>
        <div class="gallery__track" data-gallery-track tabindex="0" role="region" aria-roledescription="carrusel" aria-label="{{ 'product.gallery' | t }}">
          {%- for media in product.media -%}
            <div class="gallery__slide" data-media-id="{{ media.id }}" aria-label="{{ forloop.index }} / {{ media_count }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- assign media_alt = media.alt | default: product.title -%}
                  {%- if forloop.first -%}
                    {% render 'responsive-image', image: media, sizes: '(min-width: 990px) 55vw, 100vw', eager: true, preload: true, alt: media_alt, class: 'gallery__img' %}
                  {%- else -%}
                    {% render 'responsive-image', image: media, sizes: '(min-width: 990px) 55vw, 100vw', alt: media_alt, class: 'gallery__img' %}
                  {%- endif -%}
                {%- when 'video' -%}
                  {{ media | video_tag: image_size: '1080x', autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'gallery__video' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: class: 'gallery__video' }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- else -%}
            <div class="gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endfor -%}
        </div>
        {%- if media_count > 1 -%}
          <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="{{ 'product.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 22 %}</button>
          <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="{{ 'product.next' | t }}">{% render 'icon', name: 'chevron-right', size: 22 %}</button>
          <span class="gallery__counter" aria-hidden="true"><span data-gallery-current>1</span> / {{ media_count }}</span>
        {%- endif -%}
      </div>
      {%- if media_count > 1 and section.settings.show_thumbnails -%}
        <div class="gallery__thumbs" data-gallery-thumbs>
          {%- for media in product.media -%}
            <button type="button" class="gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb-index="{{ forloop.index0 }}" aria-label="{{ 'product.show_media' | t: index: forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', widths: '80, 160' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info" id="BuyBox-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="product__app">{% render block %}</div>

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <p class="product__text product__text--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}

          {%- when 'title' -%}
            <div class="product__title-wrap" {{ block.shopify_attributes }}>
              {%- if template.name == 'product' -%}
                <h1 class="product__title">{{ product.title | escape }}</h1>
              {%- else -%}
                <h2 class="product__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
              {%- endif -%}
            </div>

          {%- when 'rating' -%}
            {%- if rating_count > 0 -%}
              <div class="product__rating" {{ block.shopify_attributes }}>
                {% render 'stars', rating: rating, count: rating_count, link: '#reviews' %}
              </div>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="product__price" data-price-block {{ block.shopify_attributes }}>
              <div class="price price--lg">
                <span class="price__current" data-price-current>{{ current_variant.price | money_without_trailing_zeros }}</span>
                {%- liquid
                  assign show_ref = false
                  assign strike = ref_price
                  if current_variant.compare_at_price > current_variant.price and current_variant.compare_at_price > ref_price
                    assign strike = current_variant.compare_at_price
                  endif
                  if strike > current_variant.price
                    assign show_ref = true
                  endif
                  assign strike_savings = strike | minus: current_variant.price
                -%}
                <s class="price__compare" data-price-ref{% unless show_ref %} hidden{% endunless %}>
                  <span class="visually-hidden">{{ 'product.reference_price' | t }}</span> <span data-price-ref-value>{{ strike | money_without_trailing_zeros }}</span>
                </s>
                <span class="price__save" data-price-save{% unless show_ref %} hidden{% endunless %}>
                  {{- 'product.savings_short' | t }} <span data-price-save-value>{{ strike_savings | money_without_trailing_zeros }}</span>
                </span>
              </div>
              <p class="price__meta">
                <span data-price-unit{% if current_qty < 2 %} hidden{% endif %}>
                  {{- 'product.per_unit' | t }} <span data-price-unit-value>{{ per_unit | money_without_trailing_zeros }}</span>
                </span>
                {%- if block.settings.note != blank -%}<span class="price__note">{{ block.settings.note }}</span>{%- endif -%}
              </p>
            </div>

          {%- when 'bullets' -%}
            <ul class="bullets" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..5) -%}
                {%- capture key %}item_{{ i }}{% endcapture -%}
                {%- if block.settings[key] != blank -%}
                  <li class="bullets__item">{% render 'icon', name: 'check-circle', size: 20, class: 'bullets__icon' %}<span>{{ block.settings[key] }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variants" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_i = forloop.index0 -%}
                  {%- if option_i == pack_index -%}
                    <fieldset class="packs" data-option-group="{{ option_i }}">
                      <legend class="packs__legend">{{ block.settings.pack_heading | default: option.name }}</legend>
                      {%- for value in option.values -%}
                        {%- liquid
                          assign position = forloop.index
                          assign pack_variant = nil
                          for v in product.variants
                            if v.options[option_i] == value
                              assign same_rest = true
                              for o in v.options
                                if forloop.index0 != option_i and o != current_variant.options[forloop.index0]
                                  assign same_rest = false
                                endif
                              endfor
                              if same_rest
                                assign pack_variant = v
                                break
                              endif
                            endif
                          endfor
                          assign q = value | split: ' ' | first | plus: 0
                          if q < 1
                            assign q = 1
                          endif
                          assign pack_ref = unit_price | times: q
                          assign pack_price = pack_variant.price | default: pack_ref
                          assign pack_save = pack_ref | minus: pack_price
                          assign pack_unit = pack_price | divided_by: q
                          capture note_key
                            echo 'note_' | append: position
                          endcapture
                          assign pack_note = block.settings[note_key]
                          assign checked = false
                          if current_variant.options[option_i] == value
                            assign checked = true
                          endif
                        -%}
                        <label class="pack{% if checked %} is-selected{% endif %}{% if pack_variant.available == false %} is-unavailable{% endif %}" data-pack-position="{{ position }}">
                          <input class="pack__input" type="radio" name="{{ section.id }}-option-{{ option_i }}" value="{{ value | escape }}" data-option-input="{{ option_i }}"{% if checked %} checked{% endif %}>
                          <span class="pack__radio" aria-hidden="true"></span>
                          <span class="pack__main">
                            <span class="pack__title">{{ value | escape }}</span>
                            {%- if pack_note != blank -%}<span class="pack__note">{{ pack_note }}</span>{%- endif -%}
                            {%- if pack_save > 0 -%}
                              <span class="pack__save">{{ 'product.savings_short' | t }} {{ pack_save | money_without_trailing_zeros }}</span>
                            {%- endif -%}
                          </span>
                          <span class="pack__prices">
                            <span class="pack__price">{{ pack_price | money_without_trailing_zeros }}</span>
                            {%- if pack_save > 0 -%}
                              <s class="pack__ref"><span class="visually-hidden">{{ 'product.reference_price' | t }}</span> {{ pack_ref | money_without_trailing_zeros }}</s>
                            {%- endif -%}
                            {%- if q > 1 -%}
                              <span class="pack__unit">{{ pack_unit | money_without_trailing_zeros }} {{ 'product.each' | t }}</span>
                            {%- endif -%}
                          </span>
                          {%- if position == section.settings.popular_position and section.settings.popular_badge != blank -%}
                            <span class="pack__badge">{{ section.settings.popular_badge }}</span>
                          {%- elsif position == section.settings.best_position and section.settings.best_badge != blank -%}
                            <span class="pack__badge pack__badge--alt">{{ section.settings.best_badge }}</span>
                          {%- endif -%}
                        </label>
                      {%- endfor -%}
                    </fieldset>
                  {%- else -%}
                    <fieldset class="option" data-option-group="{{ option_i }}">
                      <legend class="option__legend">{{ option.name }}: <span data-option-selected="{{ option_i }}">{{ current_variant.options[option_i] }}</span></legend>
                      <div class="option__values">
                        {%- for value in option.values -%}
                          <label class="option__btn">
                            <input class="option__input" type="radio" name="{{ section.id }}-option-{{ option_i }}" value="{{ value | escape }}" data-option-input="{{ option_i }}"{% if current_variant.options[option_i] == value %} checked{% endif %}>
                            <span>{{ value | escape }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'quantity' -%}
            <div class="qty-field" {{ block.shopify_attributes }}>
              <label class="qty-field__label" for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label>
              <div class="qty" data-qty>
                <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'product.decrease' | t }}">{% render 'icon', name: 'minus', size: 18 %}</button>
                <input class="qty__input" type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric" form="{{ product_form_id }}" data-qty-input>
                <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'product.increase' | t }}">{% render 'icon', name: 'plus', size: 18 %}</button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            {%- liquid
              if is_cod
                assign cta_label = block.settings.label_override | default: settings.cod_button_label
              else
                assign cta_label = block.settings.label_override | default: settings.card_button_label
              endif
            -%}
            <div class="buy{% if settings.hide_native_buttons %} buy--app-only{% endif %}" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <div class="product-form__error" role="alert" data-form-error hidden></div>
                <button
                  type="submit"
                  name="add"
                  class="btn btn--cta btn--lg btn--block btn--pulse"
                  data-main-cta
                  data-label="{{ cta_label | escape }}"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span data-cta-label>{% if current_variant.available %}{{ cta_label }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</span>
                  {% render 'icon', name: 'arrow-right', size: 20, class: 'btn__arrow' %}
                </button>
                {%- if is_cod == false and settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
              {%- if block.settings.note != blank -%}
                <p class="buy__note">{% render 'icon', name: 'lock', size: 16 %} {{ block.settings.note }}</p>
              {%- endif -%}
            </div>

          {%- when 'delivery' -%}
            <div class="delivery" data-delivery data-template="{{ block.settings.text | escape }}" {{ block.shopify_attributes }}>
              {% render 'icon', name: 'calendar', size: 22, class: 'delivery__icon' %}
              <p class="delivery__text" data-delivery-text>{{ block.settings.fallback }}</p>
            </div>

          {%- when 'trust_icons' -%}
            <ul class="trust" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- capture text_key %}text_{{ i }}{% endcapture -%}
                {%- capture icon_key %}icon_{{ i }}{% endcapture -%}
                {%- if block.settings[text_key] != blank -%}
                  <li class="trust__item">{% render 'icon', name: block.settings[icon_key], size: 26, class: 'trust__icon' %}<span>{{ block.settings[text_key] }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'payment' -%}
            <div class="payment" {{ block.shopify_attributes }}>
              {%- if is_cod -%}
                <p class="payment__cod">{% render 'icon', name: 'cash', size: 22 %} <span>{{ block.settings.cod_text }}</span></p>
              {%- else -%}
                <ul class="payment__icons" role="list">
                  {%- for type in shop.enabled_payment_types -%}
                    <li>{{ type | payment_type_svg_tag: class: 'payment__icon' }}</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'countdown' -%}
            {%- if block.settings.end != blank -%}
              <div class="countdown" data-countdown="{{ block.settings.end | escape }}" hidden {{ block.shopify_attributes }}>
                {% render 'icon', name: 'clock', size: 20 %}
                <span>{{ block.settings.label }} <strong data-countdown-value></strong></span>
              </div>
            {%- endif -%}

          {%- when 'stock' -%}
            {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.threshold -%}
              <p class="stock" {{ block.shopify_attributes }}>{{ 'product.low_stock' | t: count: current_variant.inventory_quantity }}</p>
            {%- endif -%}

          {%- when 'accordion' -%}
            <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                {% render 'icon', name: block.settings.icon, size: 22, class: 'accordion__icon' %}
                <span>{{ block.settings.heading }}</span>
                {% render 'icon', name: 'chevron-down', size: 20, class: 'accordion__chevron' %}
              </summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              </div>
            </details>

          {%- when 'custom_liquid' -%}
            <div class="product__custom" {{ block.shopify_attributes }}>{{ block.settings.liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
  {%- if template.name == 'product' -%}
    <script type="application/ld+json">{{ product | structured_data }}</script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Ficha de producto",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto",
      "info": "Solo para la página de inicio. En la ficha se usa el producto de la página."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "white", "label": "Blanco" },
        { "value": "alt", "label": "Alterno" },
        { "value": "tint", "label": "Tinte de marca" }
      ],
      "default": "white"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Proporción de imágenes",
      "options": [
        { "value": "square", "label": "Cuadrada (1:1)" },
        { "value": "portrait", "label": "Vertical (4:5)" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "show_thumbnails", "label": "Mostrar miniaturas", "default": true },
    { "type": "header", "content": "Packs por cantidad" },
    {
      "type": "paragraph",
      "content": "Crea en el producto una opción de variante con este nombre y valores que empiecen por el número de unidades: \"1 unidad\", \"2 unidades\", \"3 unidades\". El ahorro se calcula contra el precio de 1 unidad."
    },
    { "type": "text", "id": "pack_option_name", "label": "Nombre de la opción de pack", "default": "Cantidad" },
    {
      "type": "range",
      "id": "popular_position",
      "min": 0,
      "max": 4,
      "step": 1,
      "label": "Pack \"Más popular\" (posición, 0 = ninguno)",
      "default": 2
    },
    { "type": "text", "id": "popular_badge", "label": "Etiqueta del pack más popular", "default": "Más popular" },
    { "type": "checkbox", "id": "preselect_popular", "label": "Preseleccionar el pack más popular", "default": true },
    {
      "type": "range",
      "id": "best_position",
      "min": 0,
      "max": 4,
      "step": 1,
      "label": "Pack \"Mejor precio\" (posición, 0 = ninguno)",
      "default": 3
    },
    { "type": "text", "id": "best_badge", "label": "Etiqueta del mejor precio", "default": "Mejor precio" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Texto", "default": "Retinol + Colágeno + Ácido hialurónico" },
        {
          "type": "select",
          "id": "style",
          "label": "Estilo",
          "options": [
            { "value": "eyebrow", "label": "Antetítulo" },
            { "value": "subtitle", "label": "Subtítulo (gancho del anuncio)" },
            { "value": "body", "label": "Párrafo" }
          ],
          "default": "eyebrow"
        }
      ]
    },
    { "type": "title", "name": "Título", "limit": 1, "settings": [] },
    {
      "type": "rating",
      "name": "Valoración",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Muestra la nota real de tu app de reseñas (Judge.me, Loox…). Sin reseñas no se muestra nada."
        }
      ]
    },
    {
      "type": "price",
      "name": "Precio",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "note", "label": "Nota junto al precio", "default": "Envío gratis incluido" }
      ]
    },
    {
      "type": "bullets",
      "name": "Beneficios",
      "settings": [
        { "type": "inline_richtext", "id": "item_1", "label": "Beneficio 1" },
        { "type": "inline_richtext", "id": "item_2", "label": "Beneficio 2" },
        { "type": "inline_richtext", "id": "item_3", "label": "Beneficio 3" },
        { "type": "inline_richtext", "id": "item_4", "label": "Beneficio 4" },
        { "type": "inline_richtext", "id": "item_5", "label": "Beneficio 5" }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variantes y packs",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "pack_heading", "label": "Título del selector de packs", "default": "Elige tu pack" },
        { "type": "text", "id": "note_1", "label": "Nota del pack 1", "default": "1 tubo de 110 ml" },
        { "type": "text", "id": "note_2", "label": "Nota del pack 2", "default": "La 2.ª unidad al 50 %" },
        { "type": "text", "id": "note_3", "label": "Nota del pack 3", "default": "Lleva 3 y paga 2" },
        { "type": "text", "id": "note_4", "label": "Nota del pack 4" }
      ]
    },
    { "type": "quantity", "name": "Cantidad", "limit": 1, "settings": [] },
    {
      "type": "buy_buttons",
      "name": "Botón de compra",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label_override",
          "label": "Texto del botón (opcional)",
          "info": "Vacío = el de Configuración del tema → Venta y cobro."
        },
        { "type": "text", "id": "note", "label": "Texto bajo el botón", "default": "Sin pagos por adelantado: pagas cuando lo recibes" }
      ]
    },
    {
      "type": "delivery",
      "name": "Entrega estimada",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto",
