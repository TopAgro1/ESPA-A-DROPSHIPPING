{%- liquid
  assign upsell = settings.cart_upsell_product
  assign upsell_in_cart = false
  if upsell != blank
    for item in cart.items
      if item.product_id == upsell.id
        assign upsell_in_cart = true
      endif
    endfor
  endif
-%}
<div class="drawer" data-cart-drawer aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer__content" data-cart-drawer-content>
      <header class="drawer__header">
        <h2 class="drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }} <span>({{ cart.item_count }})</span></h2>
        <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close', size: 22 %}</button>
      </header>

      <div class="drawer__body">
        {% render 'shipping-bar' %}
        {%- if cart.item_count == 0 -%}
          <div class="cart-empty">
            {% render 'icon', name: 'cart', size: 40 %}
            <p>{{ 'cart.empty' | t }}</p>
            <a class="btn btn--brand" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
          </div>
        {%- else -%}
          {% render 'cart-items' %}
          {%- if upsell != blank and upsell_in_cart == false and upsell.available -%}
            <div class="upsell">
              <p class="upsell__heading">{{ settings.cart_upsell_heading }}</p>
              <div class="upsell__card">
                {%- if upsell.featured_media -%}
                  {{ upsell.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', class: 'upsell__img', widths: '80, 160' }}
                {%- endif -%}
                <div class="upsell__info">
                  <p class="upsell__title">{{ upsell.title | escape }}</p>
                  <p class="upsell__price">{{ upsell.price | money_without_trailing_zeros }}</p>
                </div>
                <button type="button" class="btn btn--outline btn--sm" data-upsell-add="{{ upsell.selected_or_first_available_variant.id }}">{{ 'cart.add_upsell' | t }}</button>
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if cart.item_count > 0 -%}
        <footer class="drawer__footer">
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="drawer__discount">{% render 'icon', name: 'gift', size: 16 %} {{ discount.title | escape }} (−{{ discount.total_allocated_amount | money_without_trailing_zeros }})</p>
          {%- endfor -%}
          <p class="drawer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_without_trailing_zeros }}</strong></p>
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="btn btn--cta btn--lg btn--block">{{ 'cart.checkout' | t }} {% render 'icon', name: 'lock', size: 18 %}</button>
          </form>
          {%- if settings.cart_trust_text != blank -%}<p class="drawer__trust">{{ settings.cart_trust_text }}</p>{%- endif -%}
        </footer>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Carrito lateral",
  "tag": "div",
  "class": "section-cart-drawer",
  "settings": []
}
{% endschema %}
