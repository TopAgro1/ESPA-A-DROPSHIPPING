<section class="section scheme-{{ section.settings.scheme }}" data-reveal>
  <div class="container">
    <div class="final-cta{% if section.settings.image != blank %} final-cta--media{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="final-cta__media">{% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 990px) 40vw, 90vw', max_width: 1200 %}</div>
      {%- endif -%}
      <div class="final-cta__body">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="final-cta__text">{{ section.settings.text }}</p>{%- endif -%}
        <a class="btn btn--cta btn--lg btn--pulse" href="{{ section.settings.link | default: '#BuyBox' }}" {% if section.settings.link == blank %}data-scroll-buybox{% endif %}>
          {{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 20, class: 'btn__arrow' %}
        </a>
        <ul class="final-cta__trust" role="list">
          {%- for i in (1..3) -%}
            {%- capture key %}trust_{{ i }}{% endcapture -%}
            {%- if section.settings[key] != blank -%}<li>{% render 'icon', name: 'check', size: 18 %} {{ section.settings[key] }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Llamado final",
  "tag": "div",
  "class": "section-final-cta",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "white", "label": "Blanco" },
        { "value": "alt", "label": "Alterno" },
        { "value": "tint", "label": "Tinte de marca" },
        { "value": "brand", "label": "Marca" }
      ],
      "default": "brand"
    },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Tu piel lo va a notar" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Tu rutina antiedad completa, en un solo paso" },
    { "type": "inline_richtext", "id": "text", "label": "Texto", "default": "Pide hoy, recíbela en casa y paga en efectivo al recibir." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Pedir ahora – Paga al recibir" },
    { "type": "url", "id": "link", "label": "Enlace del botón", "info": "Vacío = lleva al botón de compra de la página." },
    { "type": "text", "id": "trust_1", "label": "Garantía 1", "default": "Envío gratis a toda Colombia" },
    { "type": "text", "id": "trust_2", "label": "Garantía 2", "default": "Pagas al recibir" },
    { "type": "text", "id": "trust_3", "label": "Garantía 3", "default": "30 días de garantía" }
  ],
  "presets": [{ "name": "Llamado final" }]
}
{% endschema %}
