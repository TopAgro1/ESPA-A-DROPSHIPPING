{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="section scheme-alt">
      <div class="container container--narrow center gift-card">
        <div class="logo">{% render 'logo' %}</div>
        <h1 class="h2">{{ 'gift_card.title' | t }}</h1>
        <p class="gift-card__amount">{{ gift_card.balance | money_without_trailing_zeros }}</p>
        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p>{{ 'gift_card.expired' | t }}</p>
        {%- endif -%}
        <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Apple Wallet" loading="lazy"></a>
        {%- endif -%}
        <a class="btn btn--brand" href="{{ shop.url }}">{{ 'gift_card.shop' | t }}</a>
      </div>
    </main>
  </body>
</html>
