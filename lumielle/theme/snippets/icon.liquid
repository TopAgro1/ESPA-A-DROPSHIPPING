{%- comment -%}
  Iconos SVG en línea (trazo, color = currentColor).
  Uso: {% render 'icon', name: 'truck', size: 24, class: 'icon--brand' %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
  assign stroke = 'fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"'
-%}
<svg class="icon icon--{{ name }} {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  {%- case name -%}
    {%- when 'star', 'star-half', 'whatsapp', 'instagram', 'facebook', 'tiktok', 'youtube', 'sparkle', 'play' %} fill="currentColor"
    {%- else %} {{ stroke }}
  {%- endcase -%}
