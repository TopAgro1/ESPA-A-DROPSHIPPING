{%- if settings.free_shipping_always -%}
  <p class="ship-bar ship-bar--done">{% render 'icon', name: 'truck', size: 20 %} {{ 'cart.free_shipping_always' | t }}</p>
{%- elsif settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100 | divided_by: threshold
    if percent > 100
      assign percent = 100
    endif
  -%}
  <div class="ship-bar">
    {%- if remaining > 0 -%}
      {%- assign remaining_formatted = remaining | money_without_trailing_zeros -%}
      <p>{{ 'cart.free_shipping_remaining_html' | t: amount: remaining_formatted }}</p>
    {%- else -%}
      <p>{% render 'icon', name: 'truck', size: 20 %} {{ 'cart.free_shipping_unlocked' | t }}</p>
    {%- endif -%}
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent }}"><span style="width: {{ percent }}%"></span></div>
  </div>
{%- endif -%}
