{%- comment -%}
  Sección CRO opcional: el problema en capas (qué pasa · por qué importa · por qué no lo has resuelto).
{%- endcomment -%}
<section id="Problem-{{ section.id }}" class="problem section-pt">
  <div class="page-width">
    <div class="problem__head reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h-section">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="problem__intro">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <div class="problem__grid">
      {%- for block in section.blocks -%}
        <article class="problem-card reveal" {{ block.shopify_attributes }}>
          <span class="problem-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="problem-card__title">{{ block.settings.title }}</h3>
          <p class="problem-card__text">{{ block.settings.text }}</p>
          {%- if block.settings.source_url != blank -%}
            <a class="problem-card__source" href="{{ block.settings.source_url }}" target="_blank" rel="noopener">{{ block.settings.source_label | default: block.settings.source_url }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Problema (CRO)",
  "tag": "div",
  "class": "section-problem",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Por qué tu piel reacciona" },
    { "type": "text", "id": "heading", "label": "Título", "default": "No es que tu piel sea difícil" },
    { "type": "richtext", "id": "text", "label": "Introducción", "default": "<p>Cuando la barrera cutánea está dañada, hasta los productos \"suaves\" pican. No te falta constancia: te sobran ingredientes que no necesitas.</p>" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Tarjeta",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Qué pasa" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Rojeces, tirantez y escozor después de casi cualquier crema." },
        { "type": "text", "id": "source_label", "label": "Fuente (texto)" },
        { "type": "url", "id": "source_url", "label": "Fuente (enlace)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problema (CRO)",
      "blocks": [
        { "type": "card", "settings": { "title": "Qué pasa", "text": "Rojeces, tirantez y escozor después de casi cualquier crema, incluso las que dicen ser para piel sensible." } },
        { "type": "card", "settings": { "title": "Por qué importa", "text": "Una barrera dañada pierde agua y deja pasar irritantes: cuanto más productos pruebas, más reacciona." } },
        { "type": "card", "settings": { "title": "Por qué no lo has resuelto", "text": "Rutinas de 7 pasos, fragancias ocultas y activos agresivos. Lo que no es cómodo no se vuelve rutina." } }
      ]
    }
  ]
}
{% endschema %}
