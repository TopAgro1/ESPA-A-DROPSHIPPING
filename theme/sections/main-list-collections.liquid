<section class="collection section-pt">
  <div class="page-width">
    <h1 class="h-section">{{ 'collections.all_title' | t }}</h1>
    <div class="recommended__grid recommended__grid--wrap" style="--cols: 3;">
      {%- for collection in collections -%}
        <a class="card card--collection" href="{{ collection.url }}">
          <div class="card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 990px) 33vw, 60vw', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="card__body"><h2 class="card__title">{{ collection.title }}</h2></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista de colecciones",
  "tag": "div",
  "class": "section-list-collections",
  "settings": []
}
{% endschema %}
