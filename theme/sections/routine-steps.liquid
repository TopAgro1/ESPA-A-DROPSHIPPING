{%- comment -%}
  Sección CRO opcional: cómo se usa en la rutina diaria (3 pasos).
{%- endcomment -%}
<section id="Routine-{{ section.id }}" class="routine section-pt">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h-section reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ol class="routine__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="routine-step reveal" {{ block.shopify_attributes }}>
          <div class="routine-step__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 30vw, 90vw', alt: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="routine-step__num">{{ 'sections.step' | t: number: forloop.index }}</span>
          </div>
          <h3 class="routine-step__title">{{ block.settings.title }}</h3>
          <p class="routine-step__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Rutina en pasos",
  "tag": "div",
  "class": "section-routine",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu rutina en 3 pasos" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Título", "default": "Limpia" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Lava el rostro con agua tibia y un limpiador suave." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rutina en pasos",
      "blocks": [
        { "type": "step", "settings": { "title": "Limpia", "text": "Lava el rostro con agua tibia y un limpiador suave. Seca a toquecitos." } },
        { "type": "step", "settings": { "title": "Aplica", "text": "2-3 gotas sobre la piel aún húmeda. Presiona con las palmas, sin frotar." } },
        { "type": "step", "settings": { "title": "Protege", "text": "Por la mañana, termina con tu protector solar. Por la noche, listo." } }
      ]
    }
  ]
}
{% endschema %}
