{%- liquid
  if section.settings.product != blank and request.page_type != 'product'
    assign product = section.settings.product
  endif
  assign is_placeholder = false
  if product == blank
    assign is_placeholder = true
  endif
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign media_count = product.media.size
  assign first_media_id = product.selected_or_first_available_variant.featured_media.id | default: product.featured_media.id

  case section.settings.image_ratio
    when 'square'
      assign media_ratio = '1 / 1'
    when 'portrait'
      assign media_ratio = '3 / 4.15'
    else
      assign media_ratio = product.featured_media.aspect_ratio | default: 0.75 | prepend: '' | append: ' / 1'
  endcase
-%}

<section
  id="Product-{{ section.id }}"
  class="pdp section-pt"
  data-product-section
  data-section-id="{{ section.id }}"
  data-cart-type="{{ settings.cart_type }}"
  style="--media-ratio: {{ media_ratio }}; --media-fit: {{ section.settings.image_fit }};"
>
  <div class="page-width pdp__grid">
    {%- comment -%} ============ GALERÍA ============ {%- endcomment -%}
    <div class="pdp__media" data-gallery>
      <div class="pdp__thumbs{% if media_count < 2 and is_placeholder == false %} is-hidden{% endif %}">
        <div class="pdp__thumbs-track" data-thumbs>
          {%- if is_placeholder -%}
            {%- for i in (1..3) -%}
              <button type="button" class="pdp__thumb{% if forloop.first %} is-active{% endif %}" data-thumb data-index="{{ forloop.index0 }}" aria-label="{{ 'products.media_thumb' | t: index: forloop.index }}">
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- for media in product.media -%}
              <button
                type="button"
                class="pdp__thumb{% if media.id == first_media_id %} is-active{% endif %}"
                data-thumb
                data-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                aria-label="{{ 'products.media_thumb' | t: index: forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '140px', alt: '' }}
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <span class="play-badge">{%- render 'icon', icon: 'play' -%}</span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <div class="pdp__main">
        <div class="pdp__slides" data-slides>
          {%- if is_placeholder -%}
            {%- for i in (1..3) -%}
              <div class="pdp__slide" data-slide data-index="{{ forloop.index0 }}">
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for media in product.media -%}
              <div class="pdp__slide" data-slide data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <button type="button" class="pdp__zoom" {% if section.settings.enable_zoom %}data-zoom data-src="{{ media | image_url: width: 2000 }}"{% else %}tabindex="-1"{% endif %} aria-label="{{ 'products.zoom' | t }}">
                      {%- liquid
                        if media.id == first_media_id
                          assign img_loading = 'eager'
                          assign img_preload = true
                          assign img_priority = 'high'
                        else
                          assign img_loading = 'lazy'
                          assign img_preload = false
                          assign img_priority = 'auto'
                        endif
                      -%}
                      {{
                        media
                        | image_url: width: 1600
                        | image_tag:
                          loading: img_loading,
                          preload: img_preload,
                          fetchpriority: img_priority,
                          widths: '400, 600, 800, 1000, 1200, 1600',
                          sizes: '(min-width: 990px) 45vw, 100vw',
                          alt: media.alt | default: product.title
                      }}
                    </button>
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, muted: true, playsinline: true, loop: true, image_size: '1200x' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                  {%- else -%}
                    {{ media | media_tag }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if media_count > 1 or is_placeholder -%}
          <div class="pdp__dots" data-dots aria-hidden="true">
            {%- if is_placeholder -%}
              {%- for i in (1..3) -%}<span class="pdp__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
            {%- else -%}
              {%- for media in product.media -%}<span class="pdp__dot{% if media.id == first_media_id %} is-active{% endif %}"></span>{%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ============ INFORMACIÓN Y COMPRA ============ {%- endcomment -%}
    <div class="pdp__info" data-product-info>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'rating' -%}
            {%- liquid
              assign r_value = block.settings.rating
              assign r_count = ''
              if block.settings.use_metafields and product.metafields.reviews.rating.value != blank
                assign r_value = product.metafields.reviews.rating.value.rating | round: 1
                assign r_count = product.metafields.reviews.rating_count.value
              endif
            -%}
            <div class="pdp-rating" {{ block.shopify_attributes }}>
              {%- if block.settings.link_to_reviews -%}<a href="#reviews" class="pdp-rating__link">{%- endif -%}
              {%- render 'stars', rating: r_value, size: 'sm' -%}
              <span class="pdp-rating__value">{%- render 'format-decimal', number: r_value -%}</span>
              <span class="pdp-rating__label">
                {%- if r_count != blank -%}
                  {{ 'products.reviews_count' | t: count: r_count }}
                {%- else -%}
                  {{ block.settings.label }}
                {%- endif -%}
              </span>
              {%- if block.settings.link_to_reviews -%}</a>{%- endif -%}
            </div>

          {%- when 'title' -%}
            <h1 class="pdp__title" {{ block.shopify_attributes }}>
              {%- if is_placeholder -%}{{ 'products.placeholder_title' | t }}{%- else -%}{{ product.title }}{%- endif -%}
            </h1>

          {%- when 'subtitle' -%}
            {%- if block.settings.text != blank -%}
              <p class="pdp__subtitle" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="pdp__price" {{ block.shopify_attributes }}>
              {%- if is_placeholder -%}
                <div class="price price--sale"><span class="price__current">{{ 3400 | money }}</span><s class="price__compare">{{ 3625 | money_without_currency }}</s></div>
              {%- else -%}
                {%- render 'price',
                  product: product,
                  variant: current_variant,
                  compare_no_currency: block.settings.compare_no_currency,
                  show_badge: block.settings.show_badge
                -%}
              {%- endif -%}
              {%- if block.settings.show_tax_note -%}
                <p class="pdp__tax-note">
                  {%- if cart.taxes_included -%}{{ 'products.taxes_included' | t }}{%- else -%}{{ 'products.taxes_excluded' | t }}{%- endif -%}
                  {%- if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}">{{ 'products.shipping_calculated' | t }}</a>{% endif -%}
                </p>
              {%- endif -%}
            </div>

          {%- when 'benefits' -%}
            <div class="pdp-benefits" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="pdp-benefits__heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              <ul class="pdp-benefits__list" role="list">
                {%- for i in (1..5) -%}
                  {%- assign benefit_key = 'benefit_' | append: i -%}
                  {%- assign benefit = block.settings[benefit_key] -%}
                  {%- if benefit != blank -%}
                    <li>{%- render 'icon', icon: 'check-circle' -%}<span>{{ benefit }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant or is_placeholder -%}
              <div class="pdp-variants" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index0 -%}
                  <fieldset class="pdp-variants__group">
                    <legend class="pdp-variants__legend">
                      {{ option.name }}: <span data-option-value="{{ option_index }}">{{ option.selected_value }}</span>
                    </legend>
                    {%- if block.settings.style == 'dropdown' -%}
                      <div class="select">
                        <select class="select__input" data-option-index="{{ option_index }}" aria-label="{{ option.name }}">
                          {%- for value in option.values -%}
                            <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                          {%- endfor -%}
                        </select>
                        {%- render 'icon', icon: 'chevron-down' -%}
                      </div>
                    {%- else -%}
                      <div class="pdp-variants__pills">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                          <input
                            type="radio"
                            class="visually-hidden"
                            id="{{ input_id }}"
                            name="{{ section.id }}-option-{{ option_index }}"
                            value="{{ value | escape }}"
                            data-option-index="{{ option_index }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <label class="pill" for="{{ input_id }}">{{ value }}</label>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'packs' -%}
            {%- unless is_placeholder -%}
              <div class="pdp-packs" data-packs {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="pdp-packs__heading">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign pack_key = 'pack_' | append: i
                    assign pack_key_qty = pack_key | append: '_qty'
                    assign pack_key_label = pack_key | append: '_label'
                    assign pack_key_badge = pack_key | append: '_badge'
                    assign pack_key_discount = pack_key | append: '_discount'
                    assign pack_qty = block.settings[pack_key_qty]
                    assign pack_label = block.settings[pack_key_label]
                    assign pack_badge = block.settings[pack_key_badge]
                    assign pack_discount = block.settings[pack_key_discount]
                    assign pack_full = current_variant.price | times: pack_qty
                    assign pack_total = 100 | minus: pack_discount | times: pack_full | divided_by: 100
                    assign pack_unit = pack_total | divided_by: pack_qty
                    assign pack_input = section.id | append: '-pack-' | append: i
                  -%}
                  {%- if pack_qty > 0 -%}
                    <input
                      type="radio"
                      class="visually-hidden"
                      id="{{ pack_input }}"
                      name="{{ section.id }}-pack"
                      value="{{ pack_qty }}"
                      data-pack
                      data-qty="{{ pack_qty }}"
                      data-discount="{{ pack_discount }}"
                      {% if block.settings.default_pack == i %}checked{% endif %}
                    >
                    <label class="pack" for="{{ pack_input }}">
                      <span class="pack__radio" aria-hidden="true"></span>
                      <span class="pack__text">
                        <span class="pack__label">{{ pack_label }}</span>
                        <span class="pack__unit"><span data-pack-unit>{{ pack_unit | money }}</span> {{ 'products.per_unit' | t }}</span>
                      </span>
                      {%- if pack_badge != blank -%}<span class="pack__badge">{{ pack_badge }}</span>{%- endif -%}
                      <span class="pack__prices">
                        <span class="pack__total" data-pack-total>{{ pack_total | money }}</span>
                        {%- if pack_discount > 0 -%}<s class="pack__full" data-pack-full>{{ pack_full | money }}</s>{%- endif -%}
                      </span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
                {%- if block.settings.note != blank -%}
                  <p class="pdp-packs__note">{{ block.settings.note }}</p>
                {%- endif -%}
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            {%- liquid
              assign bn_discount = block.settings.buy_now_discount | default: 0
              assign bn_code = block.settings.buy_now_discount_code | strip
              if bn_code == blank
                assign bn_discount = 0
              endif
              assign bn_price = 100 | minus: bn_discount | times: current_variant.price | divided_by: 100
            -%}
            <div class="pdp-buy" data-buy-buttons {{ block.shopify_attributes }}>
              {%- if is_placeholder -%}
                <div class="pdp-buy__row">
                  <div class="qty" aria-hidden="true"><button type="button" class="qty__btn">{%- render 'icon', icon: 'minus' -%}</button><input class="qty__input" type="text" value="1" readonly><button type="button" class="qty__btn">{%- render 'icon', icon: 'plus' -%}</button></div>
                  <button type="button" class="btn btn--outline" disabled>{{ block.settings.atc_label }}</button>
                </div>
                <button type="button" class="btn btn--primary btn--block" disabled>{{ block.settings.buy_now_label }}{% if block.settings.buy_now_show_price %} - {{ 3400 | money }}{% endif %}</button>
              {%- else -%}
                {%- form 'product', product, id: form_id, class: 'pdp-buy__form', novalidate: 'novalidate', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <div class="pdp-buy__row{% unless block.settings.show_quantity %} pdp-buy__row--no-qty{% endunless %}">
                    {%- if block.settings.show_quantity -%}
                      <div class="qty" data-qty>
                        <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.qty_decrease' | t }}">{%- render 'icon', icon: 'minus' -%}</button>
                        <input class="qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.quantity' | t }}" data-qty-input>
                        <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.qty_increase' | t }}">{%- render 'icon', icon: 'plus' -%}</button>
                      </div>
                    {%- else -%}
                      <input type="hidden" name="quantity" value="1" data-qty-input>
                    {%- endif -%}
                    <button
                      type="submit"
                      name="add"
                      class="btn btn--outline"
                      data-add-to-cart
                      data-label="{{ block.settings.atc_label | escape }}"
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      <span data-atc-text>{%- if current_variant.available -%}{{ block.settings.atc_label }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
                    </button>
                  </div>
                  {%- if block.settings.show_buy_now -%}
                    <button
                      type="button"
                      class="btn btn--primary btn--block"
                      data-buy-now
                      data-label="{{ block.settings.buy_now_label | escape }}"
                      data-show-price="{{ block.settings.buy_now_show_price }}"
                      data-discount="{{ bn_discount }}"
                      data-discount-code="{{ bn_code | escape }}"
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      <span data-buy-now-text>
                        {{- block.settings.buy_now_label -}}
                        {%- if block.settings.buy_now_show_price %} - {{ bn_price | money }}{% endif -%}
                      </span>
                    </button>
                  {%- endif -%}
                  <p class="pdp-buy__error" data-form-error role="alert" hidden></p>
                {%- endform -%}
              {%- endif -%}
              {%- if block.settings.guarantee != blank -%}
                <p class="pdp-buy__guarantee">{{ block.settings.guarantee }}</p>
              {%- endif -%}
            </div>

          {%- when 'shipping_info' -%}
            <ul class="pdp-shipping" role="list" {{ block.shopify_attributes }}>
              {%- if block.settings.shipping_text != blank -%}
                <li>{%- render 'icon', icon: 'truck' -%}<span>{{ block.settings.shipping_text }}</span></li>
              {%- endif -%}
              {%- if block.settings.show_delivery -%}
                <li>
                  {%- render 'icon', icon: 'calendar' -%}
                  <span data-delivery-estimate data-min="{{ block.settings.delivery_min }}" data-max="{{ block.settings.delivery_max }}">
                    {{ 'products.delivery_days' | t: min: block.settings.delivery_min, max: block.settings.delivery_max }}
                  </span>
                </li>
              {%- endif -%}
              {%- if block.settings.returns_text != blank -%}
                <li>{%- render 'icon', icon: 'shield' -%}<span>{{ block.settings.returns_text }}</span></li>
              {%- endif -%}
              {%- if block.settings.show_payment_icons -%}
                <li class="pdp-shipping__payments">
                  {%- render 'icon', icon: 'lock' -%}
                  <span class="payment-icons">
                    {%- for type in shop.enabled_payment_types -%}
                      {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                    {%- endfor -%}
                  </span>
                </li>
              {%- endif -%}
            </ul>

          {%- when 'ugc' -%}
            <div class="pdp-ugc" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="pdp-ugc__heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              <div class="pdp-ugc__track" data-ugc>
                {%- assign ugc_has_items = false -%}
                {%- for i in (1..8) -%}
                  {%- liquid
                    assign ugc_image_key = 'image_' | append: i
                    assign ugc_video_key = 'video_' | append: i
                    assign ugc_image = block.settings[ugc_image_key]
                    assign ugc_video = block.settings[ugc_video_key]
                    if ugc_image == blank and ugc_video != blank
                      assign ugc_image = ugc_video.preview_image
                    endif
                  -%}
                  {%- if ugc_image != blank -%}
                    {%- assign ugc_has_items = true -%}
                    <button type="button" class="pdp-ugc__item" data-ugc-item aria-label="{{ 'products.open_review_media' | t: index: i }}">
                      {{ ugc_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '120px', alt: '' }}
                      {%- if ugc_video != blank -%}
                        <span class="play-badge">{%- render 'icon', icon: 'play' -%}</span>
                        <template data-ugc-media>
                          {{ ugc_video | video_tag: autoplay: true, controls: true, playsinline: true, image_size: '1080x' }}
                        </template>
                      {%- else -%}
                        <template data-ugc-media>
                          {{ ugc_image | image_url: width: 1400 | image_tag: alt: '' }}
                        </template>
                      {%- endif -%}
                    </button>
                  {%- endif -%}
                {%- endfor -%}
                {%- unless ugc_has_items -%}
                  {%- for i in (1..6) -%}
                    <div class="pdp-ugc__item pdp-ugc__item--placeholder">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      <span class="play-badge">{%- render 'icon', icon: 'play' -%}</span>
                    </div>
                  {%- endfor -%}
                {%- endunless -%}
              </div>
            </div>

          {%- when 'collapsible_tab' -%}
            {%- liquid
              assign tab_content = block.settings.content
              if block.settings.source == 'description' and product.description != blank
                assign tab_content = product.description
              elsif block.settings.source == 'page' and block.settings.page != blank
                assign tab_content = block.settings.page.content
              endif
            -%}
            <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span>{{ block.settings.heading }}</span>
                {%- render 'icon', icon: 'chevron-down' -%}
              </summary>
              <div class="accordion__content rte">{{ tab_content }}</div>
            </details>

          {%- when 'text' -%}
            <div class="pdp-text pdp-text--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'custom_liquid' -%}
            <div class="pdp-liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ============ BARRA FIJA DE COMPRA ============ {%- endcomment -%}
  {%- if section.settings.sticky_atc != 'off' and is_placeholder == false -%}
    <div class="sticky-atc sticky-atc--{{ section.settings.sticky_atc }}" data-sticky-atc data-show-before="{{ section.settings.sticky_before }}" aria-hidden="true">
      <div class="sticky-atc__inner">
        <div class="sticky-atc__product">
          {%- if product.featured_media != blank -%}
            {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', class: 'sticky-atc__image' }}
          {%- endif -%}
          <div class="sticky-atc__text">
            <span class="sticky-atc__title">{{ product.title }}</span>
            <span class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</span>
          </div>
        </div>
        <button type="button" class="btn btn--primary" data-sticky-buy {% unless current_variant.available %}disabled{% endunless %}>
          {{ section.settings.sticky_label }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- unless is_placeholder -%}
    <script type="application/json" data-product-json>
      {{ product | json }}
    </script>
    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  {%- endunless -%}
</section>

{% schema %}
{
  "name": "Ficha de producto",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto (solo fuera de la ficha)",
      "info": "En la ficha de producto se usa siempre el producto que se está viendo. Úsalo para mostrar la ficha en la página de inicio."
    },
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de imágenes",
      "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Vertical (diseño)" },
        { "value": "square", "label": "Cuadrada" },
        { "value": "adapt", "label": "Adaptar a la imagen" }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Ajuste de imagen",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Rellenar (recorta)" },
        { "value": "contain", "label": "Contener (sin recortar)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Ampliar imagen al hacer clic",
      "default": true
    },
    {
      "type": "header",
      "content": "Barra fija de compra"
    },
    {
      "type": "select",
      "id": "sticky_atc",
      "label": "Barra fija de compra",
      "default": "mobile",
      "options": [
        { "value": "off", "label": "Nunca" },
        { "value": "mobile", "label": "Solo en móvil" },
        { "value": "all", "label": "Móvil y ordenador" }
      ]
    },
    {
      "type": "checkbox",
