<section class="password section-pt text-center">
  <div class="page-width page-width--narrow">
    <div class="password__logo">{%- render 'logo' -%}</div>
    <h1 class="h-section h-section--center">{{ 'general.password_title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="page-content__lead">{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'password__form' -%}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="Password">{{ 'general.password_label' | t }}</label>
      <input class="field__input" type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'general.password_label' | t }}">
      <button type="submit" class="btn btn--primary">{{ 'general.password_enter' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contraseña",
  "tag": "div",
  "class": "section-main-password",
  "settings": []
}
{% endschema %}
