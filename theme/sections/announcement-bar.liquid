{%- if section.settings.text != blank -%}
  <div class="announcement" style="--ann-bg: {{ section.settings.background }}; --ann-text: {{ section.settings.text_color }};">
    <div class="page-width announcement__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement__text">{{ section.settings.text }}</a>
      {%- else -%}
        <p class="announcement__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "tag": "div",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Texto",
      "default": "Envío gratis a partir de 39 € · Garantía de 30 días"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#6C7140"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#FEF9E4"
    }
  ],
  "presets": [
    { "name": "Barra de anuncios" }
  ]
}
{% endschema %}
