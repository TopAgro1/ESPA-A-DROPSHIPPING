{%- comment -%}
  "Gentle Enough To Trust Daily": imagen en círculo + testimonio destacado con selector por avatar.
{%- endcomment -%}
<section
  id="Spotlight-{{ section.id }}"
  class="spotlight section-pt"
  data-spotlight
  data-autoplay="{{ section.settings.autoplay }}"
  style="--circle-color: {{ section.settings.circle_color }};"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h-section h-section--center reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="spotlight__grid">
      <div class="spotlight__media reveal">
        <div class="spotlight__circle{% if section.settings.crop_circle %} spotlight__circle--crop{% endif %}">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 40vw, 85vw',
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="spotlight__content reveal">
        <div class="spotlight__quotes">
          {%- for block in section.blocks -%}
            <figure
              class="spotlight__quote{% if forloop.first %} is-active{% endif %}"
              id="Quote-{{ block.id }}"
              role="tabpanel"
              data-quote
              {% unless forloop.first %}aria-hidden="true"{% endunless %}
              {{ block.shopify_attributes }}
            >
              <blockquote class="spotlight__text">&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
              <figcaption>
                {%- render 'stars', rating: block.settings.rating, size: 'md' -%}
              </figcaption>
            </figure>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="spotlight__people" role="tablist" aria-label="{{ section.settings.heading | escape }}">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="spotlight__person{% if forloop.first %} is-active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="Quote-{{ block.id }}"
                data-person
              >
                <span class="spotlight__avatar">
                  {%- if block.settings.avatar != blank -%}
                    {{ block.settings.avatar | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '110px', alt: block.settings.name }}
                  {%- else -%}
                    <span class="spotlight__initials">{{ block.settings.name | slice: 0 }}</span>
                  {%- endif -%}
                </span>
                <span class="spotlight__name">{{ block.settings.name }}</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonio destacado",
  "tag": "div",
  "class": "section-spotlight",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tan suave que confías en él cada día"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen del círculo",
      "info": "Ideal: antes/después o rostro recortado en PNG con fondo transparente, 1200 × 1200 px."
    },
    {
      "type": "color",
      "id": "circle_color",
      "label": "Color del círculo",
      "default": "#ECF489"
    },
    {
      "type": "checkbox",
      "id": "crop_circle",
      "label": "Recortar la imagen en círculo",
      "info": "Desactívalo con PNG transparentes para que la imagen sobresalga del círculo.",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Cambio automático",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 0,
      "info": "0 = desactivado"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testimonio",
          "default": "He probado muchísimos productos \"suaves\" que aun así me irritaban la piel. Esta rutina se sintió diferente desde la primera semana: sin ardor, sin tirantez, solo una piel calmada y cómoda. Mis rojeces se han reducido notablemente y por fin me siento segura."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "default": "Emily R."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Foto"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Estrellas",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonio destacado",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Emily R." } },
        { "type": "testimonial", "settings": { "name": "Jessica M." } },
        { "type": "testimonial", "settings": { "name": "Michael T." } },
        { "type": "testimonial", "settings": { "name": "Sarah L." } }
      ]
    }
  ]
}
{% endschema %}
