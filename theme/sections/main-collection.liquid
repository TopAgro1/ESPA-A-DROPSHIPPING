<section class="collection section-pt">
  <div class="page-width">
    <h1 class="h-section">{{ collection.title }}</h1>
    {%- if collection.description != blank and section.settings.show_description -%}
      <div class="collection__desc rte">{{ collection.description }}</div>
    {%- endif -%}
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="recommended__grid recommended__grid--wrap" style="--cols: {{ section.settings.columns }};">
        {%- for product in collection.products -%}
          <div class="recommended__item">
            {%- render 'product-card', product: product, placeholder_index: forloop.index -%}
          </div>
        {%- else -%}
          <p class="empty-state">{{ 'collections.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección",
  "tag": "div",
  "class": "section-main-collection",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "Mostrar descripción", "default": true },
    { "type": "range", "id": "per_page", "label": "Productos por página", "min": 4, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "columns", "label": "Columnas en ordenador", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
