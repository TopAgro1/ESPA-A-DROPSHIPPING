<section class="search-page section-pt">
  <div class="page-width">
    <h1 class="h-section">{{ 'general.search' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form search-form--page">
      <label class="visually-hidden" for="SearchPageInput">{{ 'general.search' | t }}</label>
      {%- render 'icon', icon: 'search' -%}
      <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="btn btn--primary btn--sm">{{ 'general.search' | t }}</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="search-page__count">{{ 'general.search_results' | t: count: search.results_count, terms: search.terms }}</p>
        <div class="recommended__grid recommended__grid--wrap" style="--cols: 4;">
          {%- for item in search.results -%}
            <div class="recommended__item">
              {%- if item.object_type == 'product' -%}
                {%- render 'product-card', product: item, placeholder_index: forloop.index -%}
              {%- else -%}
                <a class="card card--text" href="{{ item.url }}">
                  <div class="card__body"><h2 class="card__title">{{ item.title }}</h2><p class="card__desc">{{ item.content | strip_html | truncatewords: 20 }}</p></div>
                </a>
              {%- endif -%}
            </div>
          {%- else -%}
            <p class="empty-state">{{ 'general.no_results' | t }}</p>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Búsqueda",
  "tag": "div",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
