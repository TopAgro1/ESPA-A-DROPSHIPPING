{%- comment -%}
  "Nothing Here To Irritate Your Skin": bloque de color con titular e imagen con etiquetas de ingredientes.
{%- endcomment -%}
<section
  id="Ingredients-{{ section.id }}"
  class="ingredients section-pt"
  style="--block-bg: {{ section.settings.background }}; --block-text: {{ section.settings.text_color }}; --dot-color: {{ section.settings.dot_color }}; --splash-color: {{ section.settings.splash_color }};"
>
  <div class="bleed-card ingredients__card">
    {%- if section.settings.show_splash -%}
      <div class="ingredients__splash" aria-hidden="true">
        {%- if section.settings.splash_image != blank -%}
          {{ section.settings.splash_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}
        {%- else -%}
          {%- render 'icon', icon: 'splash' -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="page-width ingredients__grid">
      <div class="ingredients__copy reveal">
        {%- if section.settings.heading != blank -%}
          <h2 class="ingredients__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ingredients__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="ingredients__visual reveal">
        <div class="ingredients__image">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1200',
                sizes: '(min-width: 990px) 30vw, 70vw',
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- else -%}
            <div class="ingredients__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </div>

        <ul class="ingredients__callouts" role="list">
          {%- for block in section.blocks -%}
            <li
              class="callout callout--{{ block.settings.align }}"
              style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --angle: {{ block.settings.angle }}deg; --line: {{ block.settings.line }}px;"
              {{ block.shopify_attributes }}
            >
              <span class="callout__dot">{%- render 'icon', icon: 'check-badge' -%}</span>
              <span class="callout__label">{{ block.settings.label }}</span>
              {%- if block.settings.line > 0 -%}
                <span class="callout__line" aria-hidden="true"></span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredientes",
  "tag": "div",
  "class": "section-ingredients",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Nada aquí que irrite tu piel"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Solo ingredientes que apoyan la barrera, seleccionados para la tolerancia diaria. Cada ingrediente se elige para calmar, proteger y ayudar a la recuperación.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen central",
      "info": "PNG con fondo transparente (ej. gotero, textura o producto), 1200 × 1200 px."
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#6C7140"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#FEF9E4"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Iconos de las etiquetas",
      "default": "#ECF489"
    },
    {
      "type": "header",
      "content": "Mancha decorativa"
    },
    {
      "type": "checkbox",
      "id": "show_splash",
      "label": "Mostrar mancha decorativa",
      "default": true
    },
    {
      "type": "color",
      "id": "splash_color",
      "label": "Color de la mancha",
      "default": "#8E9463"
    },
    {
      "type": "image_picker",
      "id": "splash_image",
      "label": "Imagen propia para la mancha (opcional)"
    }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Etiqueta",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "Fórmula sin fragancia"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Posición horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Posición vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 90
        },
        {
          "type": "select",
          "id": "align",
          "label": "Lado del texto",
          "default": "right",
          "options": [
            { "value": "right", "label": "A la derecha del icono" },
            { "value": "left", "label": "A la izquierda del icono" }
          ]
        },
        {
          "type": "range",
          "id": "line",
          "label": "Longitud de la línea punteada",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 24
        },
        {
          "type": "range",
          "id": "angle",
          "label": "Ángulo de la línea",
          "min": 0,
          "max": 360,
          "step": 5,
          "unit": "°",
          "default": 45
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredientes",
      "blocks": [
        { "type": "callout", "settings": { "label": "Humectantes idénticos a la piel", "x": 6, "y": 22, "angle": 50, "line": 26 } },
        { "type": "callout", "settings": { "label": "Activos calmantes suaves", "x": 72, "y": 22, "angle": 135, "line": 22 } },
        { "type": "callout", "settings": { "label": "Lípidos reparadores de la barrera", "x": 0, "y": 59, "angle": 20, "line": 26 } },
        { "type": "callout", "settings": { "label": "Conservantes no irritantes", "x": 76, "y": 64, "angle": 200, "line": 22 } },
        { "type": "callout", "settings": { "label": "Fórmula sin fragancia", "x": 40, "y": 90, "angle": 300, "line": 30 } }
      ]
    }
  ]
}
{% endschema %}
