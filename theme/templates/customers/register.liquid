<section class="account section-pt section-pb">
  <div class="page-width page-width--narrow account__box">
    <h1 class="h-section h-section--center">{{ 'customer.register_title' | t }}</h1>
    {%- form 'create_customer', class: 'account__form' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="RegisterFirstName">{{ 'customer.first_name' | t }}</label>
        <input class="field__input" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLastName">{{ 'customer.last_name' | t }}</label>
        <input class="field__input" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.email' | t }}</label>
        <input class="field__input" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.password' | t }}</label>
        <input class="field__input" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block">{{ 'customer.create_account' | t }}</button>
    {%- endform -%}
  </div>
</section>
