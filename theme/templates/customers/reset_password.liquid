<section class="account section-pt section-pb">
  <div class="page-width page-width--narrow account__box">
    <h1 class="h-section h-section--center">{{ 'customer.reset_title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'account__form' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.password' | t }}</label>
        <input class="field__input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label>
        <input class="field__input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block">{{ 'customer.reset_submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
