<section class="account section-pt section-pb">
  <div class="page-width">
    <p><a href="{{ routes.account_url }}" class="account__link">{{ 'customer.back_to_account' | t }}</a></p>
    <h1 class="h-section">{{ 'customer.order' | t }} {{ order.name }}</h1>
    <p>{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    <table class="account__table">
      <thead><tr><th>{{ 'customer.product' | t }}</th><th>{{ 'products.quantity' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>{{ line_item.title | link_to: line_item.product.url }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="2">{{ 'cart.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- for shipping_method in order.shipping_methods -%}
          <tr><td colspan="2">{{ shipping_method.title }}</td><td>{{ shipping_method.price | money }}</td></tr>
        {%- endfor -%}
        <tr><td colspan="2"><strong>{{ 'customer.total' | t }}</strong></td><td><strong>{{ order.total_price | money }}</strong></td></tr>
      </tfoot>
    </table>
    <div class="account__grid">
      <div><h2 class="account__subtitle">{{ 'customer.billing_address' | t }}</h2>{{ order.billing_address | format_address }}</div>
      <div><h2 class="account__subtitle">{{ 'customer.shipping_address' | t }}</h2>{{ order.shipping_address | format_address }}</div>
    </div>
  </div>
</section>
